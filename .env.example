# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: docker compose up -d  (see docker-compose.yml)
DATABASE_URL=postgresql://mediyum:mediyum@127.0.0.1:5432/mediyum
# Production: the Supabase Postgres on the Hetzner box. Use the SESSION pooler
# (port 5432), not the transaction pooler (6543) — Payload/Drizzle needs
# prepared statements and long-lived connections for migrations.

# ─── Payload ─────────────────────────────────────────────────────────────────
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CRON_SECRET=
PREVIEW_SECRET=

# ─── Payments (Paystack — ZAR) ───────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ─── Media storage (S3-compatible; Hetzner Object Storage) ───────────────────
# Leave S3_BUCKET empty to fall back to local disk in development.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
